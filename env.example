# Copiar a .env y ajustar. El archivo .env no se commitea.

# Conexión a PostgreSQL
SAIMC_DATABASE_URL=postgresql+psycopg://saimc:saimc@localhost:5432/saimc

# Bandeja de entrada: el operador deja acá las capturas y los textos.
# La captura no estructura nada; solo tiene que llegar el archivo.
SAIMC_INBOX_DIR=inbox

# Evidencia preservada. Cada archivo ingerido se mueve acá con su hash por
# nombre. Nunca se modifica ni se elimina: es la base de la Transparency Layer.
SAIMC_RAW_STORE_DIR=data/raw

# Clave HMAC del webhook de WAHA (docs/decisions.md, 2026-08-15). Va idéntica
# en `config.hmac.key` del lado de WAHA. Sin esta variable, /webhooks/whatsapp
# rechaza todo.
SAIMC_WHATSAPP_WEBHOOK_HMAC_KEY=
