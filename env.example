# Copiar a .env y ajustar. El archivo .env no se commitea.

# ------------------------------------------------------------
# Base de datos
# ------------------------------------------------------------
SAIMC_DATABASE_URL=postgresql+psycopg://saimc:saimc@localhost:5432/saimc

# ------------------------------------------------------------
# Rutas de ingesta
# ------------------------------------------------------------
# Bandeja de entrada: el operador deja acá las capturas y los textos.
SAIMC_INBOX_DIR=inbox

# Evidencia preservada. Cada archivo ingerido se mueve acá con su hash
# por nombre. Nunca se modifica ni se elimina.
SAIMC_RAW_STORE_DIR=data/raw

# ------------------------------------------------------------
# Autenticación del operador
# ------------------------------------------------------------
# HTTP Basic para /curation/*, /evidence/{id}, /catalog, /docs,
# /control y /marketing. Sin contraseña, esas rutas responden 503.
SAIMC_CURATION_USERNAME=operador
SAIMC_CURATION_PASSWORD=

# Ventana de contexto de ráfaga en minutos: cuántos mensajes vecinos
# del mismo canal se muestran como referencia en /curation.
SAIMC_BURST_WINDOW_MINUTES=10

# ------------------------------------------------------------
# WhatsApp / WAHA
# ------------------------------------------------------------
# Clave HMAC del webhook de WAHA. Va idéntica en `config.hmac.key`
# del lado de WAHA. Sin esta variable, /webhooks/whatsapp rechaza todo.
SAIMC_WHATSAPP_WEBHOOK_HMAC_KEY=

# Clave del hash del emisor en grupos de WhatsApp. El emisor se
# guarda como HMAC-SHA256, nunca el número. Mínimo 32 caracteres.
# Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA rotar sin migrar los hashes ya guardados.
SAIMC_SENDER_HASH_KEY=

# SAIMC llamando de vuelta a WAHA para el backfill de histórico.
SAIMC_WAHA_BASE_URL=http://127.0.0.1:3000
SAIMC_WAHA_API_KEY=
SAIMC_WAHA_SESSION=default

# ------------------------------------------------------------
# Asistente de extracción por LLM en /curation
# ------------------------------------------------------------
# Solo llena campos sin resolver, y solo cuando el operador aprieta
# el botón — nunca automáticamente. Sin clave, el botón no aparece.
# El costo es ADICIONAL al plan Pro de Claude (por token).

# Cómo quedó, sin gastar: .venv/bin/python -m saimc.llm.provider

# El interruptor: por dónde se llama al modelo. Elige también la clave.
# Un valor que no sea uno de estos dos deja el asistente apagado.
#   anthropic -> API directa de Anthropic (default)
#   vercel    -> Vercel AI Gateway
SAIMC_LLM_PROVIDER=anthropic

# Se usa si el proveedor es anthropic. Formato: sk-ant-api03-...
SAIMC_ANTHROPIC_API_KEY=

# Se usa si el proveedor es vercel. También la usa Jev (más abajo), sea
# cual sea el proveedor. Formato: vck_...
# SAIMC_LLM_JEV_API_KEY es el nombre anterior de esta clave y sigue
# valiendo: rige cuando esta está vacía.
SAIMC_VERCEL_API_KEY=

# Modelo canónico, SIN prefijo de proveedor. El código agrega el
# prefijo cuando corresponde (vercel -> "anthropic/<modelo>").
SAIMC_LLM_MODEL=claude-sonnet-5

# Timeout por llamada desde la cola, en segundos. El pre-cálculo y el
# backtest usan su propio --timeout (120 por defecto).
SAIMC_LLM_TIMEOUT=30.0

# Nombres anteriores de las dos de arriba, que siguen valiendo si
# están vacías: SAIMC_LLM_ASSIST_MODEL y SAIMC_LLM_ASSIST_TIMEOUT.

# Archivo JSONL donde se registran las invocaciones del asistente.
# Lo lee /control y lo usa H0 para excluir anuncios asistidos.
SAIMC_LLM_ASSIST_LOG_PATH=data/llm-assist-log.jsonl

# ------------------------------------------------------------
# Carril 0 (pre-cálculo)
# ------------------------------------------------------------
# El pre-cálculo descarta solo lo que el modelo descarta por «fuera
# de foco» o «sin datos» cuando las reglas no ven producto piloto.
# Cada lane se apaga solo si su cota en /curation/auditoria pasa la
# meta (10% texto, 20% imagen). Estimá el costo antes en seco.
SAIMC_LANE0_TEXT_ENABLED=false
# Imágenes: el carril 0 las lee por el texto de su OCR guardado
# (docs/spec-slice-ocr-como-texto.md). Con este en false, las imágenes
# cuyo OCR no nombra ningún piloto ni siquiera pasan por el modelo.
SAIMC_LANE0_IMAGE_ENABLED=false
# Jev como segundo juez del carril 0 de texto: un descarte del modelo
# pide además P(sí) < 0,2, y Jev descarta solo si el asistente no
# propuso. Apagado, Jev queda en sombra. Su cota propia está en
# /curation/auditoria.
SAIMC_LANE0_JEV_ENABLED=false
# Jev como árbitro del desacuerdo (slice jev-desacuerdo): un texto que
# el modelo descarta y en el que las reglas ven un piloto se descarta si
# Jev da P(sí) < 0,2. Solo cuenta con SAIMC_LANE0_JEV_ENABLED=true. Nace
# apagado: su cota propia está en /curation/auditoria y el primer tramo
# se audita completo.
SAIMC_LANE0_JEV_ARBITER_ENABLED=false

# ------------------------------------------------------------
# Carril 1 (pre-cálculo)
# ------------------------------------------------------------
# El pre-cálculo guarda solo las filas de los textos que el motor
# manda al carril 1, y salen en el tablero sin esperar a nadie
# (docs/spec-slice-B2b.md). Lo aceptado se audita después, en
# /curation/auditoria; con 30 sin auditar el carril se frena solo.
SAIMC_LANE1_ENABLED=false
# Carril 1 para imágenes, leídas por el texto de su OCR guardado (slice
# OCR como texto). Solo cuenta con SAIMC_LANE1_ENABLED=true. Tiene freno,
# auditoría y cota propios, aparte de los del texto: un freno de imágenes
# no frena los textos ni al revés. Nace apagado; antes de encenderlo,
# mirá el en seco: .venv/bin/python -m saimc.validation.lane1
SAIMC_LANE1_IMAGE_ENABLED=false
# Si el freno apagó el carril 1 por error auditado, se vuelve a encender
# fijando acá el día desde el que cuenta lo auditado (AAAA-MM-DD). Vacío,
# cuenta todo. Es una decisión del operador: no se pone sola.
# SAIMC_LANE1_AUDIT_SINCE=2026-10-20
# Tope de filas por anuncio del carril 1. Sin definir o en 0, no hay tope
# (2026-10-19, docs/spec-slice-lane1-sin-tope.md): entran las listas
# largas. Un N positivo vuelve a frenar los anuncios de más de N filas;
# con 4 se vuelve a lo de antes. Un negativo no arranca. Pide reiniciar.
# SAIMC_LANE1_MAX_ROWS=4

# ------------------------------------------------------------
# Jev como señal en sombra (Vercel AI Gateway)
# ------------------------------------------------------------
# Con el interruptor encendido Y la clave puesta, el pre-cálculo le
# hace tres preguntas cerradas (triage, producto, moneda) a cada
# texto pendiente. Solo anota en `validation_detail`: no cambia
# estado, carril ni procedencia. Apagado o sin clave, todo funciona
# como antes. El texto sale redactado (sin teléfonos).
SAIMC_LLM_JEV_ENABLED=false

# La clave es la del gateway: SAIMC_VERCEL_API_KEY, más arriba.

# Segundos por llamada. No positivo -> 10 y se avisa en el registro.
SAIMC_LLM_JEV_TIMEOUT=10

# Tope en USD por corrida del pre-cálculo, aparte de
# SAIMC_PREFILL_MAX_COST (que es el de Claude). En 0 no se llama.
SAIMC_LLM_JEV_MAX_COST=0.01

# Jev también sobre el texto del OCR de las imágenes (slice OCR como
# texto): la pasada pregunta por las imágenes pendientes que ya tienen el
# OCR guardado (nunca paga OCR para preguntar), y en el carril 0 Jev es
# segundo juez y árbitro de una imagen. Exige Jev activo (interruptor y
# clave). Nace apagado: el umbral 0,2 se calibró solo con textos.
SAIMC_JEV_OCR_ENABLED=false

# ------------------------------------------------------------
# SEO: origen público del sitio
# ------------------------------------------------------------
# Sin barra final. Lo usan canonical, og:* y /sitemap.xml, que necesitan
# URL absolutas. Sin él se usa el host que ve uvicorn (el interno, detrás
# de Caddy), así que en producción hay que ponerlo.
SAIMC_SITE_URL=

# ------------------------------------------------------------
# Landing (pie de página)
# ------------------------------------------------------------
# Los cuatro son opcionales: se dibuja solo el que tenga valor.
# Los tres enlaces deben empezar con http:// o https://.
# Son de la marca, nunca personales.
SAIMC_LINK_FACEBOOK=
SAIMC_LINK_WHATSAPP=
SAIMC_LINK_TELEGRAM=
SAIMC_CONTACT_EMAIL=
# Enlace de donación (QvaPay u otro) para /apoyar (http:// o https://). El QR
# para pagar desde cuentas cubanas va como archivo, no como variable:
# src/saimc/web/static/apoyar-qr-clasica.png y apoyar-qr-bandec.png. Con alguno de los dos existe /apoyar.
SAIMC_DONATE_URL=
# ------------------------------------------------------------
# Seguimiento de la cuenta de Instagram de Guani
# ------------------------------------------------------------
# Solo lee la cuenta propia (python -m saimc.instagram.sync, cada 3 h
# con systemd/saimc-instagram.timer). Sin token, el lote avisa y sale
# sin fallar. Alta y comandos: docs/comandos.md, «Seguimiento de Instagram».

# Id y secreto de la app de Meta for Developers. Sirven para el alta
# manual (cambiar el token corto por el de larga duración); el lote no
# los usa.
SAIMC_INSTAGRAM_APP_ID=
SAIMC_INSTAGRAM_APP_SECRET=

# Token de larga duración RECIÉN GENERADO. Solo siembra la tabla
# instagram_credentials en la primera corrida; desde ahí el lote lo
# renueva y guarda el nuevo en la base. Cambiarlo acá después no tiene
# efecto: para reemplazarlo, ver docs/comandos.md. Nunca por chat.
SAIMC_INSTAGRAM_ACCESS_TOKEN=

# Segundos por llamada a la API.
SAIMC_INSTAGRAM_TIMEOUT=15
