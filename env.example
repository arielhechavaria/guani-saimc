# Copiar a .env y ajustar. El archivo .env no se commitea.

# Conexión a PostgreSQL
SAIMC_DATABASE_URL=postgresql+psycopg://saimc:saimc@localhost:5432/saimc

# Bandeja de entrada: el operador deja acá las capturas y los textos.
# La captura no estructura nada; solo tiene que llegar el archivo.
SAIMC_INBOX_DIR=inbox

# Evidencia preservada. Cada archivo ingerido se mueve acá con su hash por
# nombre. Nunca se modifica ni se elimina: es la base de la Transparency Layer.
SAIMC_RAW_STORE_DIR=data/raw

# HTTP Basic para /curation/* y /evidence/{id} (docs/decisions.md, 2026-08-13).
# Sin contraseña, esas rutas responden 503. /control no lo requiere.
SAIMC_CURATION_USERNAME=operador
SAIMC_CURATION_PASSWORD=

# Ventana de contexto de ráfaga en minutos: cuántos mensajes vecinos del mismo
# canal se muestran como referencia de solo lectura en /curation.
SAIMC_BURST_WINDOW_MINUTES=10

# Clave HMAC del webhook de WAHA (docs/decisions.md, 2026-08-15). Va idéntica
# en `config.hmac.key` del lado de WAHA. Sin esta variable, /webhooks/whatsapp
# rechaza todo.
SAIMC_WHATSAPP_WEBHOOK_HMAC_KEY=

# Clave del hash del emisor en los grupos de WhatsApp (docs/spec-slice-B5.md).
# El emisor de cada mensaje de grupo se guarda como HMAC-SHA256 con esta clave,
# nunca el número. Al menos 32 caracteres; más corta se trata como ausente. Se
# genera con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Sin esta variable el emisor queda en nulo y la ingesta sigue igual.
# Guardarla también en el respaldo: rotarla o perderla corta el historial por
# vendedor, porque los hashes nuevos no coinciden con los viejos.
SAIMC_SENDER_HASH_KEY=

# SAIMC llamando DE VUELTA a la API de WAHA, para el backfill de histórico
# desde /catalog (docs/decisions.md, 2026-08-17). Si WAHA y SAIMC comparten
# VPS, usar 127.0.0.1: el puerto de la API de WAHA (3000 por default) no
# debería estar expuesto a internet.
SAIMC_WAHA_BASE_URL=http://127.0.0.1:3000
SAIMC_WAHA_API_KEY=
SAIMC_WAHA_SESSION=default

# Asistente de extracción por LLM en /curation (docs/decisions.md, 2026-09-01).
# Solo llena los campos que las reglas dejaron sin resolver, y solo cuando el
# operador lo pide con el botón — nunca de forma automática. Sin esta clave,
# el botón no aparece y la cola funciona exactamente igual que hoy: es un
# estado soportado, no una configuración a medio hacer.
# El costo es ADICIONAL al plan Pro de Claude (facturado por token, ver
# docs/costos.md).
SAIMC_ANTHROPIC_API_KEY=

# Carril 0 encendido (docs/spec-slice-B2a.md): el pre-cálculo
# (`python -m saimc.extraction.prefill --execute`) descarta solo lo que el
# modelo descarta por «fuera de foco» o «sin datos» cuando las reglas no ven
# ningún producto piloto. Uno por tipo: cada uno se apaga solo si su cota en
# /curation/auditoria pasa la meta (10% texto, 20% imagen). Con el de texto
# encendido, el pre-cálculo también le paga propuesta a los textos sin foco:
# estimá el costo antes con el pre-cálculo en seco.
SAIMC_LANE0_TEXT_ENABLED=false
SAIMC_LANE0_IMAGE_ENABLED=false

# Jev como señal en sombra (docs/spec-slice-A6b.md). Con el interruptor
# encendido Y la clave puesta, el pre-cálculo le hace tres preguntas cerradas
# (triage, producto, moneda) a cada texto pendiente y, al curar, la respuesta
# se anota en `validation_detail`. Solo anota: no cambia el estado, el carril
# ni la procedencia de ninguna fila. Apagado, o encendido sin clave, todo
# funciona exactamente como antes.
# La clave es la de Vercel AI Gateway. El texto sale redactado (sin teléfonos).
# El costo es aparte del de Claude: del orden de 0,00002 a 0,00007 USD por
# texto (docs/costos.md).
SAIMC_LLM_JEV_ENABLED=false
SAIMC_LLM_JEV_API_KEY=
# Segundos por llamada. Un valor que no sea un número positivo se reemplaza
# por 10 y se avisa en el registro.
SAIMC_LLM_JEV_TIMEOUT=10
# Tope en USD por corrida del pre-cálculo, aparte de SAIMC_PREFILL_MAX_COST
# (que es el de Claude). En 0 no se llama a Jev. Peor caso con el valor por
# defecto: 8 corridas por día x 0,01 = 0,08 USD diarios.
SAIMC_LLM_JEV_MAX_COST=0.01

# Contacto y redes en el pie de la landing (`/`). Los cuatro son opcionales:
# se dibuja solo el que tenga valor, y sin ninguno esa parte del pie no
# aparece. Los tres enlaces tienen que empezar con http:// o https://; un valor
# que no lo haga se ignora. Son los del proyecto, nunca los de un anunciante.
# Todos son de la marca (Guani, por Leira Studio), nunca personales: el
# correo es el de la marca y no el de una persona, y SAIMC_LINK_WHATSAPP es
# el enlace de un canal de la marca. El número de WhatsApp que usa la ingesta
# (WAHA) no se publica ni se usa como contacto: no va acá.
SAIMC_LINK_FACEBOOK=
SAIMC_LINK_WHATSAPP=
SAIMC_LINK_TELEGRAM=
SAIMC_CONTACT_EMAIL=
