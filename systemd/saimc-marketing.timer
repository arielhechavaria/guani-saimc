[Unit]
Description=Genera las tarjetas de marketing de Guani cada manana

[Timer]
# 05:00 hora de La Habana, no del VPS (que corre en UTC): systemd acepta el
# huso en la propia expresion. Una hora antes del envio de los datos al canal
# de WhatsApp (saimc-canal-datos.timer, 06:00), que aprueba solo el borrador si
# el operador no lo toco (docs/decisions.md 2026-10-26).
OnCalendar=*-*-* 05:00:00 America/Havana
# Si el VPS estuvo apagado a la hora, corre al volver (igual que el backup).
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
