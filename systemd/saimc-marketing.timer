[Unit]
Description=Genera las tarjetas de marketing de Guani cada manana

[Timer]
# 06:00 hora de La Habana, no del VPS (que corre en UTC): systemd acepta el
# huso en la propia expresion. Antes de que el operador abra la cola.
OnCalendar=*-*-* 06:00:00 America/Havana
# Si el VPS estuvo apagado a la hora, corre al volver (igual que el backup).
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
