[Unit]
Description=Genera las tarjetas de marketing del dia de Guani (no publica nada)
After=postgresql.service

[Service]
# oneshot: lee, rasteriza y termina. Sin cola ni servicio permanente (decision
# cerrada 3), igual que saimc-prefill y saimc-instagram.
Type=oneshot
User=ariel
WorkingDirectory=/home/ariel/guani/guani-saimc

# Deja los PNG en var/marketing/AAAA-MM-DD/ (relativo a WorkingDirectory) y
# borra las carpetas de mas de 30 dias. Usa las cifras del dia anterior.
# Codigo 0 = salio al menos una tarjeta. Codigo 1 = no hay Chromium
# (playwright install chromium) o ninguna tarjeta tenia datos: la unidad queda
# en «failed» y se ve en `systemctl --failed`.
# No gasta: no llama a ninguna API de pago ni publica en ninguna red.
ExecStart=/home/ariel/guani/guani-saimc/.venv/bin/python -m saimc.marketing.daily --execute

# Hasta tres tarjetas, un Chromium sin cabeza por tarjeta: de sobra.
TimeoutStartSec=10min
