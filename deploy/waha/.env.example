# Copiar a .env en este mismo directorio (deploy/waha/) y completar con
# valores reales. Este archivo NO se commitea (ver .gitignore de la raíz,
# mismo patrón que env.example para SAIMC).
#
# Confirmado contra waha.devlike.pro/docs/how-to/config/ (2026-08-15) — no
# inventado.

# --- Dashboard y API de WAHA ---
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=
WAHA_API_KEY=

# --- Webhook hacia SAIMC ---
# URL pública, o de red interna si WAHA y SAIMC comparten VPS. Si comparten
# VPS y SAIMC corre en el host (uvicorn directo, sin Docker): NO uses
# 127.0.0.1 acá, ese es el loopback del propio contenedor de WAHA, no el del
# host. Usá host.docker.internal (mapeado a host-gateway en
# docker-compose.yml) y el puerto donde escucha uvicorn.
WHATSAPP_HOOK_URL=http://host.docker.internal:8000/webhooks/whatsapp
WHATSAPP_HOOK_EVENTS=message,message.any

# TIENE que ser idéntica a SAIMC_WHATSAPP_WEBHOOK_HMAC_KEY en el .env de
# SAIMC (src/saimc/config.py). Es lo único que verifica que un mensaje
# entrante viene de esta instancia de WAHA y no de cualquiera que encuentre
# la URL del webhook.
WHATSAPP_HOOK_HMAC_KEY=

# --- Archivos adjuntos (fotos sin caption, docs/decisions.md 2026-08-21) ---
# WAHA descarga los adjuntos por defecto y publica su ruta en `media.url` del
# payload; SAIMC la pide con WAHA_API_KEY y la ingiere como evidencia. Si
# WHATSAPP_DOWNLOAD_MEDIA quedara en `false`, el payload llega con
# `hasMedia: true` y SIN `media.url`, y las fotos se descartan en silencio.
# Se deja explícito justamente para que ese modo de falla no sea invisible.
WHATSAPP_DOWNLOAD_MEDIA=true

# Solo imágenes fijas: SAIMC descarta cualquier otro mimetype igual (ver
# `_MEDIA_SUFFIX_BY_MIMETYPE`), así que bajar videos y audios solo gastaría
# disco del VPS. `image/webp` queda afuera a propósito: WhatsApp reencoda las
# fotos a JPEG, así que el webp es casi siempre un sticker.
WHATSAPP_FILES_MIMETYPES=image/jpeg,image/png
